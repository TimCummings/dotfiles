# don't "logout" (close window) with CTRL+D
setopt IGNORE_EOF

# shorten escape timeout
KEYTIMEOUT=1

# emacs mode for `^a`, `^e`
bindkey -e

# CTRL-Left-Right jumps words
bindkey "\e[1;5D" backward-word
bindkey "\e[1;5C" forward-word
# real delete (delete forward)
bindkey "\e[3~" delete-char
# MacOS specific
if [[ $OSTYPE == "darwin"* ]]; then
# Home and end
  bindkey "^[[H" beginning-of-line
  bindkey "^[[F" end-of-line
fi

# "word characters" are alphanumerics only, like `w` in Vim
# this should e.g. make `^w` stop at nonalphanumerics, not continue until whitespace
autoload -U select-word-style
select-word-style bash

# aliases
{{- range $key, $value := .abbreviations }}
alias {{ $key }}={{ $value | squote }}
{{- end }}

alias l='ls -al --color'
if [[ $OSTYPE == "darwin"* ]]; then
  # MacOS
  alias ls='ls -G'
fi

alias nnn={{or (and (eq .chezmoi.os "darwin") "'nnn -eoR'") "'nnn-nerd-static -eoR'"}}

# setup autocomplete
zmodload zsh/complist
autoload -Uz compinit
compinit

# highlight completion selection
zstyle ':completion:*' menu select

# - first try simple completion `''`
# - then try case sensitive
# - then try case insensitive
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'

# bind Shift + Tab to reverse cycle through autocomplete options
bindkey '^[[Z' reverse-menu-complete

# CachyOS ssh authentication socket
if [[ -z ${SSH_AUTH_SOCK:-} &&
  -n ${XDG_RUNTIME_DIR:-} &&
  -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

# functions

# NNN: enable cd on quit with ^G
function n {
  # Block nesting of nnn in subshells
  if [[ "${NNNLVL:-0}" -ge 1 ]]; then
    echo "nnn is already running"
    return
  fi

  NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

  # The backslash allows one to alias n to nnn if desired without making an
  # infinitely recursive alias
  {{- if eq .chezmoi.os "darwin" }}
  \nnn -eoR "$@"
  {{- else }}
  \nnn-nerd-static -eoR "$@"
  {{- end }}

  if [ -f "$NNN_TMPFILE" ]; then
    . "$NNN_TMPFILE"
    rm -f "$NNN_TMPFILE" > /dev/null
  fi
}

# fzf autocomplete & keybindings
[ -f "${XDG_CONFIG_HOME}"/fzf/fzf.zsh ] && source "${XDG_CONFIG_HOME}"/fzf/fzf.zsh

# Homebrew package manager
if [[ $OSTYPE == "darwin"* ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# mise version manager
if type mise &> /dev/null; then
  eval "$(mise activate zsh)"
else
  echo "Mise is not installed; skipping!"
fi



# OSC 133 emission for jump to previous/next prompt
typeset -gi _osc133_command_active=0

function _osc133_emit() {
  printf '\e]133;%s\e\\' "$1"
}

function _osc133_preexec() {
  _osc133_command_active=1
  _osc133_emit "C"
}

function _osc133_precmd() {
  local command_status=$?

  if (( _osc133_command_active )); then
    _osc133_emit "D;${command_status}"
    _osc133_command_active=0
  fi

  return "$command_status"
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec _osc133_preexec
add-zsh-hook precmd _osc133_precmd



# starship prompt
if type starship &> /dev/null; then
  eval "$(starship init zsh)"
else
  echo "Starship is not installed; skipping!"
fi

PROMPT=$'%{\e]133;A\e\\%}'"${PROMPT}"$'%{\e]133;B\e\\%}'

# source nix if present
[[ -r /etc/profile.d/nix.sh ]] && source /etc/profile.d/nix.sh
