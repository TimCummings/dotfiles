# define foundational XDG vars first so they are available for expansion in other vars
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# hydrate ENV variables from chezmoi data file
{{- range $key, $value := .env.shared }}
export {{ $key }}={{ $value }}
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
{{- range $key, $value := .env.macos }}
export {{ $key }}={{ $value | quote }}
{{- end }}
{{- else if eq .chezmoi.os "linux" }}
{{- range $key, $value := .env.linux }}
export {{ $key }}={{ $value | quote }}
{{- end }}
{{- end }}

# make path array unique: no duplicate entries
typeset -U path

# Make sure ~/.local/bin is in PATH at the front
path=("$HOME/.local/bin" $path)
